     """The PID file is malformed; the message names the file and the entry."""
 
 
+class _UniqueKeySafeLoader(yaml.SafeLoader):
+    """SafeLoader that rejects repeated explicitly declared mapping keys."""
+
+    def __init__(self, stream):
+        super().__init__(stream)
+        self._checked_mappings = set()
+
+    def flatten_mapping(self, node):
+        # Check before merging; inherited keys may be explicitly overridden.
+        # This hook also visits inline merge sources skipped by construct_mapping().
+        if node in self._checked_mappings:
+            # Aliases can revisit nodes already containing inherited keys.
+            return super().flatten_mapping(node)
+
+        self._checked_mappings.add(node)
+        keys = set()
+        for key_node, _ in node.value:
+            if key_node.tag == "tag:yaml.org,2002:merge":
+                continue
+            if key_node.tag == "tag:yaml.org,2002:value":
+                key_node.tag = "tag:yaml.org,2002:str"  # Match SafeConstructor's handling of '='.
+            key = self.construct_object(key_node, deep=True)
+            if not isinstance(key, Hashable):
+                continue  # SafeConstructor reports unhashable keys as usual.
+            if key in keys:
+                raise ConstructorError(
+                    "while constructing a mapping",
+                    node.start_mark,
+                    f"found duplicate key {key!r}",
+                    key_node.start_mark,
+                )
+            keys.add(key)
+
+        return super().flatten_mapping(node)
+
+
