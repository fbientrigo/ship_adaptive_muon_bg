+def test_duplicate_yaml_keys_are_rejected_by_load(tmp_path, text, key, line, column):
+    path = tmp_path / "duplicate.yaml"
+    path.write_text(text)
+
+    with pytest.raises(PIDConfigError) as error:
+        load(str(path))
+
+    message = str(error.value)
+    assert str(path) in message
+    assert "duplicate key" in message and key in message
+    assert f"line {line}, column {column}" in message
+    problem_mark = error.value.__cause__.problem_mark
+    assert problem_mark.name == str(path)
+    assert problem_mark.line == line - 1
+    assert problem_mark.column == column - 1
+
